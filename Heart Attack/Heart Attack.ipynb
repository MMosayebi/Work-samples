  {
   "cell_type": "code",
   "execution_count": 12,
   "id": "0e72fbea-bb1c-401a-8b47-1daf43bf7069",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "The Jaccard score of 1 = 0.76\n",
