      "\n",
      "The Log loss = 6.17\n"
     ]
    }
   ],
   "source": [
    "# The Jaccard score shows whether our accuracy was higher for predicting a heart attack or for predicting no heart attack.\n",
    "from sklearn.metrics import jaccard_score, log_loss\n",
    "\n",
    "print(f\"The Jaccard score of 1 = {jaccard_score(y_test,target,pos_label=1):.2f}\")\n",
    "print(f\"The Jaccard score of 0 = {jaccard_score(y_test,target,pos_label=0):.2f}\\n\")\n",
    "\n",
    "print(f\"The Log loss = {log_loss(y_test,target):.2f}\")"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "89cb7522-90d9-42ed-b388-926c8fae52d6",
   "metadata": {},
   "source": [
    "<p>According to the heatmap, our model has been trained with good accuracy.</p>\n",
    "<p>However, the most important factor for us is FN.</p>\n",
    "<p>The number 2 indicates that our model predicted 'no heart attack risk', but the actual value was 'heart attack risk'.</p>"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 13,
   "id": "b20fc00b-40b7-49cd-ae27-8152c27828ec",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "⚠️ HIGH RISK: The patient may have heart attack (probability = 58.08)%\n",
      "Recommend: Immediate cardiology consultation\n"
     ]
    }
   ],
   "source": [
    "new_patient = np.array([[40,1,2,130,200,1,0,145,1,2.5,2,0,1]])\n",
    "\n",
    "scaled_new_patient = ss.transform(new_patient)\n",
    "\n",
    "pred = model.predict_proba(scaled_new_patient)[:,1]\n",
    "\n",
    "# The following code was generated with the help of AI (to set a standard threshold).\n",
    "\n",
    "if pred >= 0.4:\n",
    "    print(f\"⚠️ HIGH RISK: The patient may have heart attack (probability = {(pred[0]*100):.2f})%\")\n",
    "    print(\"Recommend: Immediate cardiology consultation\")\n",
    "\n",
    "elif pred >= 0.35:\n",
    "    print(f\"🟡 BORDERLINE ZONE: Probability = {pred[0]:.2f}\")\n",
    "    print(\"⚠️ The patient is IN THE FN DANGER ZONE (False Negative risk)\")\n",
    "    print(\"Recommend: Second opinion, additional tests (ECG/Troponin), or specialist review\")\n",
    "\n",
    "elif pred >= 0.25:\n",
    "    print(f\"🟠 LOW-MEDIUM RISK: Probability = {pred[0]:.2f}\")\n",
    "    print(\"The patient is close to FN danger zone\")\n",
    "    print(\"Recommend: Routine follow-up or repeat test in 24h\")\n",
    "\n",
    "else:\n",
    "    print(f\"✅ LOW RISK: Probability = {pred[0]:.2f}\")\n",
    "    print(\"Everything is good. No FN risk for this patient\")\n",
    "    print(\"Recommend: Safe discharge\")"
   ]
  }
